  "openai_moderation": "[[\"sexual\", 0.16156649589538574], [\"self-harm\", 0.04329247772693634], [\"self-harm/intent\", 0.008526647463440895], [\"violence\", 0.00039682950591668487], [\"self-harm/instructions\", 0.0002922767598647624], [\"harassment\", 0.00025571443256922066], [\"sexual/minors\", 0.0002166006452171132], [\"hate\", 6.848899647593498e-05], [\"violence/graphic\", 4.9032769311452284e-05], [\"harassment/threatening\", 2.858274274331052e-05], [\"hate/threatening\", 2.2207402707863366e-06]]",
